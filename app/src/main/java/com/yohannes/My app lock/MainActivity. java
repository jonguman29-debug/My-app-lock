package com.yohannes.myapplock;

import android.app.Activity;
import android.os.Bundle;
import android.graphics.Color;
import android.view.Gravity;
import android.widget.*;

public class MainActivity extends Activity {

    private EditText pinInput;

    @Override
    protected void onCreate(Bundle savedInstanceState) {
        super.onCreate(savedInstanceState);

        LinearLayout layout = new LinearLayout(this);
        layout.setOrientation(LinearLayout.VERTICAL);
        layout.setGravity(Gravity.CENTER);
        layout.setPadding(40, 40, 40, 40);
        layout.setBackgroundColor(Color.rgb(17, 24, 39));

        TextView title = new TextView(this);
        title.setText("🔐 MyAppLock");
        title.setTextColor(Color.WHITE);
        title.setTextSize(28);
        title.setGravity(Gravity.CENTER);

        pinInput = new EditText(this);
        pinInput.setHint("Enter PIN");
        pinInput.setInputType(2);
        pinInput.setTextColor(Color.WHITE);
        pinInput.setHintTextColor(Color.LTGRAY);

        Button unlock = new Button(this);
        unlock.setText("UNLOCK");

        unlock.setOnClickListener(v -> {
            if (pinInput.getText().toString().equals("1234")) {
                Toast.makeText(this, "Unlocked ✅", Toast.LENGTH_SHORT).show();
            } else {
                Toast.makeText(this, "Wrong PIN ❌", Toast.LENGTH_SHORT).show();
            }
        });

        layout.addView(title);
        layout.addView(pinInput);
        layout.addView(unlock);

        setContentView(layout);
    }
}
